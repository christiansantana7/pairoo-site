{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/coin/:addr([A-Za-z0-9]{20,64})", "destination": "/coin" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
